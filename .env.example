# ========================================================
# DREWTIFULL — ENVIRONMENT CONFIGURATION
# ========================================================

# App Base URL
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# --------------------------------------------------------
# 1. DATABASE CONFIGURATION (PostgreSQL + Prisma)
# --------------------------------------------------------
# Set DATABASE_URL to connect to your PostgreSQL instance.
# If left empty, Drewtifull operates in high-performance local JSON
# repository mode stored at `.data/projects.json`, with zero setup needed!
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/drewtifull?schema=public"

# --------------------------------------------------------
# 2. OBJECT STORAGE (Cloudflare R2 or S3-Compatible)
# --------------------------------------------------------
# For production photo uploads. When unconfigured, photos are saved
# locally to the public asset upload directory or loaded via data URLs.
R2_ACCOUNT_ID="your_cloudflare_account_id"
R2_ACCESS_KEY_ID="your_r2_access_key_id"
R2_SECRET_ACCESS_KEY="your_r2_secret_access_key"
R2_BUCKET_NAME="drewtifull-assets"
R2_PUBLIC_DOMAIN="https://assets.drewtifull.com"

# --------------------------------------------------------
# 3. AUTHENTICATION & SECURITY
# --------------------------------------------------------
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="drewtifull_super_secret_session_key_change_in_production"

# --------------------------------------------------------
# 4. OPTIONAL AI WRITING ASSISTANT
# --------------------------------------------------------
# If provided, powers non-destructive love letter rephrasing and polish.
# If omitted, intelligent client-side tone algorithms provide crafted suggestions.
OPENAI_API_KEY=""
